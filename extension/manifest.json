{
  "manifest_version": 3,
  "name": "新词新站点点通",
  "version": "0.1.0",
  "description": "在 sim.3ue.co 上：当前页域名按注册时间排序、关键词表收集新进热词、每月拉 Stripe 结账页的引荐网站找站、查一个关键词各种组合的域名注册情况；从 web.cafe 新词发现服务拉基础词找词。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "新词新站点点通",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "sidePanel",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://sim.3ue.co/*",
    "https://new.web.cafe/*",
    "http://127.0.0.1:8793/*"
  ]
}
